generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  INSTRUCTOR
  LEARNER
}

enum ImportJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(LEARNER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Topic {
  id          String     @id @default(cuid())
  title       String
  description String?
  order       Int        @unique
  subTopics   SubTopic[]
  quizzes     Quiz[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model SubTopic {
  id          String      @id @default(cuid())
  topicId     String
  title       String
  description String?
  order       Int
  topic       Topic       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  paragraphs  Paragraph[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([topicId, order])
  @@index([topicId])
}

model Law {
  id          String      @id @default(cuid())
  abbreviation String     @unique
  name        String
  description String?
  version     String?
  source      String?
  paragraphs  Paragraph[]
  importJobs  ImportJob[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Paragraph {
  id             String             @id @default(cuid())
  lawId          String
  subTopicId     String?
  number         String
  title          String?
  currentText    String
  currentVersion String
  law            Law                @relation(fields: [lawId], references: [id], onDelete: Cascade)
  subTopic       SubTopic?          @relation(fields: [subTopicId], references: [id], onDelete: SetNull)
  versions       ParagraphVersion[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([lawId, number])
  @@index([lawId])
  @@index([subTopicId])
}

model ParagraphVersion {
  id          String    @id @default(cuid())
  paragraphId String
  version     String
  text        String
  importedAt  DateTime  @default(now())
  paragraph   Paragraph @relation(fields: [paragraphId], references: [id], onDelete: Cascade)

  @@unique([paragraphId, version])
  @@index([paragraphId])
}

model ImportJob {
  id                 String          @id @default(cuid())
  lawId              String
  startedAt          DateTime        @default(now())
  finishedAt         DateTime?
  status             ImportJobStatus @default(PENDING)
  importedParagraphs Int             @default(0)
  changedParagraphs  Int             @default(0)
  message            String?
  law                Law             @relation(fields: [lawId], references: [id], onDelete: Cascade)

  @@index([lawId])
  @@index([status])
}

model Quiz {
  id        String   @id @default(cuid())
  title     String
  topicId   String?
  topic     Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([topicId])
}
